# Porta da API
PORT=4400
# Caminho do banco SQLite
DB_PATH=./data/engajadev.db
# Arquivo com as regras do jogo (pontos, limites, cooldown, limiar do Top Geral, virada da semana)
REGRAS_PATH=./config/regras.json
# E-mails de quem administra (pode mudar as regras pela tela de admin), separados por vírgula
ADMIN_EMAILS=
# Em produção o cookie de sessão sai com a flag Secure (só HTTPS)
NODE_ENV=development
